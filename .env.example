# Server Environment
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Database Configuration (SQLite or PostgreSQL)
# For local SQLite:
DATABASE_PATH=./data/bizflow.db
# For managed PostgreSQL (Vercel Postgres, Neon, Supabase, etc.):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DATABASE_SSL=true

# Localization & Default Currency
DEFAULT_CURRENCY=NGN
CURRENCY_SYMBOL=₦

# Paystack Payment Gateway (Subscription Billing & Checkout)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
